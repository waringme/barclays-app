# Adobe Brand Concierge (optional overrides).
# Defaults match waringme/barclays-xwalk/blocks/brand-concierge.
# Public client identifiers, NOT secrets. The Adobe configuration must allow
# the app's actual domain and have a published concierge attached.
# Adobe scripts load only after explicit consent on /brand-concierge.
BRAND_CONCIERGE_DATASTREAM_ID=fe057ec8-5a57-4d9e-92a3-0b989df885ad
BRAND_CONCIERGE_ORG_ID=BF9C27AA6464801C0A495FD0@AdobeOrg
BRAND_CONCIERGE_REGION=nld2

# Live Barclays product card shown on Home. These settings are server-side.
# Independent of the legacy CTA developer-tool settings below.
BARCLAYS_AEM_PUBLISH_ORIGIN=https://publish-p147324-e2050468.adobeaemcloud.com
BARCLAYS_PRODUCT_CARD_PATH=/content/dam/barclays-xwalk/fragments/barclays-product-card

# The AEM settings below apply only to /fragments and the preserved CTA API routes.
# ---------------------------------------------------------------------------
# CTA content fragment source configuration
#
# These defaults mirror the ACCA EDS `content-fragment` block. Copy this file
# to `.env.local` and fill in your own AEM publish host to fetch live data.
# ---------------------------------------------------------------------------

# The AEM publish origin that hosts the GraphQL persisted query endpoint.
# Leave blank to run the app in MOCK mode (renders a sample CTA fragment).
AEM_PUBLISH_ORIGIN=https://publish-p147324-e2050468.adobeaemcloud.com

# Persisted GraphQL query path used to fetch a CTA fragment by path.
# This matches the query the EDS content-fragment block uses.
AEM_GRAPHQL_QUERY=/graphql/execute.json/ref-demo-eds/CTAByPath

# Direct (non-persisted) GraphQL endpoint, used server-side to list a
# fragment's authored variations for the dropdown. The persisted query above
# does not expose the `_variations` field, so this is a separate lookup.
AEM_GRAPHQL_DIRECT_ENDPOINT=/content/_cq_graphql/ref-demo-eds/endpoint.json

# Adobe I/O Runtime wrapper service that proxies the GraphQL request so a
# browser / third-party app can call it without hitting CORS. This is the same
# gateway the EDS block posts to on publish.
CF_WRAPPER_SERVICE_URL=https://3635370-refdemoapigateway-stage.adobeioruntime.net/api/v1/web/ref-demo-api-gateway/fetch-cf

# Default content fragment path to load on first page render.
DEFAULT_CF_PATH=/content/dam/mandg/en/fragments/promotions/cf-1

# Default variation (leave as "master" unless you author variations).
DEFAULT_CF_VARIATION=master
